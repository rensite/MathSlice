{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "SectionLab isolated production static hosting: private S3 and HTTPS CloudFront",
  "Resources": {
    "SiteBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {"Fn::Sub": "sectionlab-production-${AWS::AccountId}-${AWS::Region}"},
        "PublicAccessBlockConfiguration": {"BlockPublicAcls": true, "IgnorePublicAcls": true, "BlockPublicPolicy": true, "RestrictPublicBuckets": true},
        "OwnershipControls": {"Rules": [{"ObjectOwnership": "BucketOwnerEnforced"}]},
        "BucketEncryption": {"ServerSideEncryptionConfiguration": [{"ServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]},
        "VersioningConfiguration": {"Status": "Enabled"},
        "Tags": [{"Key": "Project", "Value": "sectionlab"}, {"Key": "Environment", "Value": "production"}]
      }
    },
    "OriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {"OriginAccessControlConfig": {"Name": {"Fn::Sub": "${AWS::StackName}-s3"}, "Description": "Only SectionLab distribution may read the private bucket", "OriginAccessControlOriginType": "s3", "SigningBehavior": "always", "SigningProtocol": "sigv4"}}
    },
    "CachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {"CachePolicyConfig": {
        "Name": {"Fn::Sub": "${AWS::StackName}-origin-cache"},
        "Comment": "Honor origin no-cache HTML and immutable hashed assets",
        "MinTTL": 0, "DefaultTTL": 0, "MaxTTL": 31536000,
        "ParametersInCacheKeyAndForwardedToOrigin": {
          "EnableAcceptEncodingBrotli": true, "EnableAcceptEncodingGzip": true,
          "CookiesConfig": {"CookieBehavior": "none"},
          "HeadersConfig": {"HeaderBehavior": "none"},
          "QueryStringsConfig": {"QueryStringBehavior": "none"}
        }
      }}
    },
    "HeadersPolicy": {
      "Type": "AWS::CloudFront::ResponseHeadersPolicy",
      "Properties": {"ResponseHeadersPolicyConfig": {
        "Name": {"Fn::Sub": "${AWS::StackName}-security"},
        "Comment": "SectionLab production HTTPS security headers",
        "SecurityHeadersConfig": {
          "ContentSecurityPolicy": {"Override": true, "ContentSecurityPolicy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"},
          "ContentTypeOptions": {"Override": true},
          "FrameOptions": {"Override": true, "FrameOption": "DENY"},
          "ReferrerPolicy": {"Override": true, "ReferrerPolicy": "strict-origin-when-cross-origin"},
          "StrictTransportSecurity": {"Override": true, "AccessControlMaxAgeSec": 31536000, "IncludeSubdomains": false, "Preload": false}
        },
        "CustomHeadersConfig": {"Items": [{"Header": "Permissions-Policy", "Value": "camera=(), microphone=(), geolocation=()", "Override": true}]}
      }}
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true, "IPV6Enabled": true,
          "Comment": "SectionLab production (Project=sectionlab)",
          "DefaultRootObject": "index.html", "HttpVersion": "http2", "PriceClass": "PriceClass_100",
          "Origins": [{"Id": "private-s3", "DomainName": {"Fn::GetAtt": ["SiteBucket", "RegionalDomainName"]}, "OriginAccessControlId": {"Ref": "OriginAccess"}, "S3OriginConfig": {"OriginAccessIdentity": ""}}],
          "DefaultCacheBehavior": {
            "TargetOriginId": "private-s3", "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": ["GET", "HEAD"], "CachedMethods": ["GET", "HEAD"], "Compress": true,
            "CachePolicyId": {"Ref": "CachePolicy"}, "ResponseHeadersPolicyId": {"Ref": "HeadersPolicy"}
          },
          "CustomErrorResponses": [
            {"ErrorCode": 403, "ResponseCode": 404, "ResponsePagePath": "/404.html", "ErrorCachingMinTTL": 0},
            {"ErrorCode": 404, "ResponseCode": 404, "ResponsePagePath": "/404.html", "ErrorCachingMinTTL": 0}
          ],
          "ViewerCertificate": {"CloudFrontDefaultCertificate": true}
        },
        "Tags": [{"Key": "Project", "Value": "sectionlab"}, {"Key": "Environment", "Value": "production"}]
      }
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {"Ref": "SiteBucket"},
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {"Sid": "ReadOnlyFromSectionLabCloudFront", "Effect": "Allow", "Principal": {"Service": "cloudfront.amazonaws.com"}, "Action": "s3:GetObject", "Resource": {"Fn::Sub": "${SiteBucket.Arn}/*"}, "Condition": {"StringEquals": {"AWS:SourceArn": {"Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"}}}},
            {"Sid": "DenyInsecureTransport", "Effect": "Deny", "Principal": "*", "Action": "s3:*", "Resource": [{"Fn::GetAtt": ["SiteBucket", "Arn"]}, {"Fn::Sub": "${SiteBucket.Arn}/*"}], "Condition": {"Bool": {"aws:SecureTransport": "false"}}}
          ]
        }
      }
    }
  },
  "Outputs": {
    "BucketName": {"Value": {"Ref": "SiteBucket"}},
    "DistributionId": {"Value": {"Ref": "Distribution"}},
    "SiteUrl": {"Value": {"Fn::Sub": "https://${Distribution.DomainName}"}}
  }
}
